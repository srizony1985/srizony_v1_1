{
  "name": "srizony",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "node scripts/db-generate-guard.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:migrate:drizzle": "drizzle-kit migrate",
    "db:seed": "tsx seed-structural.ts",
    "db:repair": "tsx scripts/repair-cms.ts",
    "db:seed:reset": "tsx seed-structural.ts --reset",
    "db:bootstrap": "npm run db:init && npm run db:seed",
    "db:reset-cms": "tsx scripts/reset-cms-content.ts",
    "db:content:reset": "tsx scripts/reset-content-details.ts",
    "db:content:bootstrap": "npm run db:content:reset && npm run db:seed",
    "db:media:public-migrate": "tsx scripts/migrate-public-media.ts",
    "db:audit:dataset": "tsx scripts/audit-cms-dataset.ts",
    "cms:audit:static": "tsx scripts/audit-static-data-usage.ts",
    "cms:pipeline": "npm run db:bootstrap && npm run cms:audit:static && npm run db:audit:dataset && npm run test:functional && npx tsc --noEmit",
    "db:rebuild-cms": "npm run db:migrate && tsx scripts/reset-cms-content.ts && tsx seed-structural.ts --reset",
    "test:functional": "tsx --test tests/*.test.ts && node --test tests/*.test.mjs",
    "db:seed:demo": "tsx scripts/seed-demo-preview.ts",
    "db:seed:demo:remove": "tsx scripts/remove-demo-preview.ts",
    "backup:production": "bash scripts/backup-production.sh",
    "backup:google-drive": "node scripts/backup-google-drive-json.mjs",
    "backup:google-drive:full": "node scripts/backup-google-drive-json.mjs --full",
    "backup:google-drive:list": "node scripts/backup-google-drive-json.mjs --list-required",
    "backup:google-drive:archive": "node scripts/backup-google-drive.mjs",
    "restore:google-drive": "node scripts/restore-google-drive.mjs",
    "drive-data:export": "node scripts/backup-google-drive-json.mjs --full --local",
    "db:media:cleanup-unrecoverable": "node scripts/cleanup-unrecoverable-media.mjs",
    "db:media:cleanup-unrecoverable:apply": "node scripts/cleanup-unrecoverable-media.mjs --apply",
    "db:init": "node scripts/db-init.mjs",
    "db:reset": "node scripts/db-reset.mjs",
    "db:restore": "node scripts/restore-google-drive-json.mjs",
    "db:backup": "node scripts/run-db-backup.mjs",
    "db:restore:local": "node scripts/restore-google-drive-json.mjs --local",
    "db:seed:registry": "tsx scripts/seed-cms-registry.ts",
    "db:seed:ui-demo": "node scripts/seed-ui-demo.mjs",
    "db:remove:ui-demo": "node scripts/remove-ui-demo.mjs",
    "api:seed:ui-demo": "node scripts/upload-ui-demo-api.mjs",
    "api:remove:ui-demo": "node scripts/remove-ui-demo-api.mjs",
    "test:ui-demo": "node --test tests/ui-demo-content.test.mjs",
    "db:reset-and-seed": "node scripts/db-reset.mjs --seed",
    "db:reset-and-restore-local": "node scripts/db-reset.mjs --seed --restore-local"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@neon/config": "^1.8.3",
    "@neon/env": "^1.5.0",
    "@neondatabase/serverless": "^1.2.1",
    "@next/env": "^16.3.8",
    "class-variance-authority": "^0.7.1",
    "drizzle-orm": "^0.45.3",
    "framer-motion": "^14.11.1",
    "lucide-react": "^1.75.0",
    "next": "^16.3.8",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.4.0",
    "pg": "^8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "^5.6.0",
    "react-undraw-illustrations": "file:packages/react-undraw-illustrations",
    "sonner": "^2.0.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "@esbuild-kit/esm-loader": "npm:tsx@^4.23.15"
  }
}
