{
  "name": "srizony",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx seed-structural.ts",
    "db:repair": "tsx scripts/repair-cms.ts",
    "db:seed:reset": "tsx seed-structural.ts --reset",
    "db:bootstrap": "npm run db:migrate && npm run db:seed",
    "db:reset-cms": "tsx scripts/reset-cms-content.ts",
    "db:content:reset": "tsx scripts/reset-content-details.ts",
    "db:content:bootstrap": "npm run db:content:reset && npm run db:seed",
    "db:media:public-migrate": "tsx scripts/migrate-public-media.ts",
    "db:audit:dataset": "tsx scripts/audit-cms-dataset.ts",
    "cms:audit:static": "tsx scripts/audit-static-data-usage.ts",
    "cms:pipeline": "npm run db:bootstrap && npm run cms:audit:static && npm run db:audit:dataset && npm run test:functional && npx tsc --noEmit",
    "db:rebuild-cms": "npm run db:migrate && tsx scripts/reset-cms-content.ts && tsx seed-structural.ts --reset",
    "test:functional": "tsx --test tests/*.test.ts && node --test tests/*.test.mjs",
    "db:seed:demo": "tsx scripts/seed-demo-preview.ts",
    "db:seed:demo:remove": "tsx scripts/remove-demo-preview.ts",
    "backup:production": "bash scripts/backup-production.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@neon/config": "^1.8.3",
    "@neon/env": "^1.5.0",
    "@neondatabase/serverless": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.51.0",
    "next": "^16.3.8",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.6.0",
    "react-undraw-illustrations": "file:packages/react-undraw-illustrations",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
