# Optional exact host allowlist additions. Defaults always include:
# images.unsplash.com, api.dicebear.com, images.pexels.com
# Never use wildcards. Redirects are checked against this allowlist.
DRIVE_JSON_IMAGE_FETCH_HOSTS=

# Maximum size for each ready image embedded in media_items.json (default 25 MiB).
DRIVE_JSON_MAX_IMAGE_BYTES=26214400

# Maximum total size of one JSON table snapshot (default 200 MiB).
DRIVE_JSON_MAX_FILE_BYTES=209715200

# Required only if a ready media_items row points to an S3-compatible object key.
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
NEON_OBJECT_STORAGE_BUCKET=uploads
NEON_PUBLIC_ASSETS_BUCKET=public-assets
