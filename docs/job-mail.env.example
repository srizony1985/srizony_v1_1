# Server-side only. Never expose these as NEXT_PUBLIC_* variables.
# Use the actual Gmail / Google Workspace mailbox that owns the App Password.
GMAIL_USER=no-reply@srizony.admin
# Generate this App Password from the same Google account after enabling 2-Step Verification.
# Spaces may be included as Google displays them; the mailer removes whitespace.
GMAIL_APP_PASSWORD=your-16-character-google-app-password

# Optional. Omit JOB_MAIL_FROM to send as GMAIL_USER.
# If different from GMAIL_USER, it must be a verified Gmail / Workspace Send-As alias.
# JOB_MAIL_FROM="Srizony Foundation <no-reply@srizony.admin>"
JOB_MAIL_REPLY_TO=recruitment@srizony.admin

# Required by the existing protected maintenance cron.
CRON_SECRET=replace-with-a-long-random-secret
