# App
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Primary SQL database (Neon PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# CMS database/document-store selector
# google-drive = primary JSON document store; neon = secondary JSON document store and current relational database
DATA_PROVIDER_DEFAULT=google-drive
# Use a random secret with at least 32 characters. Do not reuse the service-account key.
CMS_PROVIDER_COOKIE_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# CMS authentication (use the variables your current deployment already configures)
CMS_SESSION_SECRET=replace-with-a-long-random-session-secret
CMS_ADMIN_USERS_JSON=[]

# Google Cloud service account / Drive API
GOOGLE_CLOUD_PROJECT_ID=your-google-cloud-project-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=srizony-cms@your-google-cloud-project-id.iam.gserviceaccount.com
# Paste the private_key from the service-account JSON; preserve newlines as \n in this env value.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
# Share this folder with the service-account email, or use a folder inside a Shared Drive.
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id

# Existing Neon Object Storage configuration (optional; required for current media storage)
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
NEON_OBJECT_STORAGE_BUCKET=uploads
NEON_PUBLIC_ASSETS_BUCKET=public-assets
NEON_PUBLIC_ASSETS_BASE_URL=

# Optional public map key used by the existing landing-page map
NEXT_PUBLIC_MAPTILER_API_KEY=
